# Postgres (Supabase) — task history, ledger, and provider catalog persistence.
# Never expose these to the browser; only the Node server reads them.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini — used for (a) live task-output generation and (b) structured intent
# parsing of the raw prompt. Set exactly ONE of these. If both GEMINI_API_KEY
# and GOOGLE_API_KEY are set in your environment, the @google/genai SDK
# silently prefers GOOGLE_API_KEY — the server detects and warns about this
# collision at startup, but you should still avoid setting both.
GEMINI_API_KEY=

# Optional: comma-separated list of allowed browser origins for CORS.
# Defaults to http://localhost:5173 if unset.
ALLOWED_ORIGINS=http://localhost:5173

PORT=3001
NODE_ENV=development
